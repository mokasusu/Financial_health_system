# ==============================================================================
# HỆ THỐNG TRÍCH XUẤT BCTC & ĐÁNH GIÁ SỨC KHỎE DOANH NGHIỆP
# File cấu hình biến môi trường mẫu (Copy thành .env và điền giá trị thực tế)
# ==============================================================================

# 1. Cấu hình AI Analysis (Qwen API - Chuẩn OpenAI API compatible)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 2. Cấu hình OCR Cục bộ trên Windows (Đường dẫn Tesseract OCR)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# 3. Môi trường ứng dụng
ENVIRONMENT=development
LOG_LEVEL=INFO
