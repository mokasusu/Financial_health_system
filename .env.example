# OpenRouter AI Configuration
# Create your API Key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Supported models: 'openrouter/free' (recommended free meta-model), 'google/gemma-4-31b-it:free', or paid models ('anthropic/claude-3.5-sonnet', 'openai/gpt-4o')
OPENROUTER_MODEL=openrouter/free

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
